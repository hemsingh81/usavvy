{
  "name": "@usavvy/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.1",
    "@usavvy/config": "workspace:*",
    "@usavvy/service-kernel": "workspace:*",
    "@usavvy/shared-types": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "google-auth-library": "^11.0.0",
    "pdfkit": "^0.19.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
